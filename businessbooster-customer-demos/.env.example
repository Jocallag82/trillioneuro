# 32+ random characters. Signs demo session cookies. Rotating it signs everyone out of every demo.
DEMO_SESSION_SECRET=

# Access codes per demo: comma-separated. Remove a code to revoke it (and every session opened with it).
# Variable name = DEMO_TOKENS_ + demo id upper-cased with non-alphanumerics as underscores.
DEMO_TOKENS_MCCLOSKEYS_BAKERY=

# Optional: session lifetime in hours (default 168 = 7 days)
DEMO_SESSION_TTL_HOURS=168
