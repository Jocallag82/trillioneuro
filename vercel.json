{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=(), payment=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://kxzywyflylkcqoidiqmo.supabase.co https://ipapi.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
      },
      "continue": true
    },
    {
      "src": "/(.*)\\.(webm|mp4|jpg|jpeg|png|ico|woff2)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.trillioneuro.com"
        }
      ],
      "headers": {
        "Location": "https://trillioneuro.com/$1"
      },
      "status": 308
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.quadrillioneuro.com"
        }
      ],
      "headers": {
        "Location": "https://quadrillioneuro.com/$1"
      },
      "status": 308
    },
    {
      "src": "/quadrillioneuro/?",
      "has": [
        {
          "type": "host",
          "value": "trillioneuro.com"
        }
      ],
      "headers": {
        "Location": "https://quadrillioneuro.com/"
      },
      "status": 308
    },
    {
      "src": "/quadrillioneuro/(.*)",
      "has": [
        {
          "type": "host",
          "value": "trillioneuro.com"
        }
      ],
      "headers": {
        "Location": "https://quadrillioneuro.com/$1"
      },
      "status": 308
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "quadrillioneuro.com"
        }
      ],
      "dest": "/quadrillioneuro/index.html"
    },
