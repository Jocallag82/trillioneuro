    },
    {
      "src": "/terms/?",
      "has": [
        {
          "type": "host",
          "value": "quadrillioneuro.com"
        }
      ],
      "dest": "/quadrillioneuro/terms.html"
    },
    {
      "src": "/auction\\.html",
      "has": [
        {
          "type": "host",
          "value": "quadrillioneuro.com"
        }
      ],
      "headers": {
        "Location": "/auction"
      },
      "status": 308
    },
    {
      "src": "/privacy\\.html",
      "has": [
        {
          "type": "host",
          "value": "quadrillioneuro.com"
        }
      ],
