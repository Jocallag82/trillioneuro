      "dest": "/claim.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms/?",
      "dest": "/terms.html"
    },
    {
      "src": "/record\\.html",
      "headers": {
        "Location": "/record"
      },
      "status": 308
    },
    {
      "src": "/claim\\.html",
      "headers": {
