    },
    {
      "src": "/index\\.html",
      "has": [
        {
          "type": "host",
          "value": "quadrillioneuro.com"
        }
      ],
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/seats/?",
