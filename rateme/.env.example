# RateMe.ie environment variables. Never commit real values.
DATABASE_URL=postgres://user:password@host:6543/postgres   # pooled connection; app uses schema "rateme"
APP_URL=https://rateme.ie                                   # canonical public URL (no trailing slash)
APP_ENV=production                                          # production | preview | development | test
APP_SECRET=                                                 # 32+ random bytes; keys IP hashing
ALLOW_INDEXING=false                                        # set true only on the canonical production domain
STRIPE_SECRET_KEY=sk_test_...                               # test mode until launch
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AUTOMATIC_TAX=false                                  # true once Stripe Tax is configured
ALLOW_LIVE_PAYMENTS=false                                   # second gate: live keys are refused unless true
RESEND_API_KEY=                                             # transactional email
EMAIL_FROM="RateMe.ie <hello@rateme.ie>"
SUPPORT_EMAIL=support@rateme.ie
CRON_SECRET=                                                # protects /api/cron/maintenance
